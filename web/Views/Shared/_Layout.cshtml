                </a>

                <div class="menu-label">QUẢN LÝ KHO</div>

                <a asp-controller="Stores" asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-shop-window"></i>
                    <span>Cửa hàng</span>
                </a>

                <a asp-controller="Inventory" asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-boxes"></i>
                    <span>Tồn kho</span>
                </a>

                <div class="menu-label">PHÂN TÍCH KINH DOANH</div>

                <a asp-controller="Analytics" asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-bar-chart-line"></i>
                    <span>Phân tích kinh doanh</span>
                </a>

                <a asp-controller="Rfm" asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-people"></i>
                    <span>Phân tích khách hàng</span>
                </a>

                <div class="menu-label">MACHINE LEARNING</div>

                <a asp-controller="Forecast" asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-graph-up-arrow"></i>
                    <span>Dự báo nhu cầu</span>
                </a>

                <a asp-controller="ModelTraining" asp-action="Index"
                   class="menu-item">
                    <i class="bi bi-cpu"></i>
                    <span>Huấn luyện mô hình</span>
                </a>

                <div class="menu-label">HỆ THỐNG</div>

                <a asp-controller="Account" asp-action="Profile"
                   class="menu-item">
                    <i class="bi bi-person-circle"></i>
                    <span>Tài khoản</span>
                </a>

            </div>

            <div class="sidebar-footer">
                <i class="bi bi-shield-check"></i>
                <span>RetailFlow v1.0</span>
            </div>

        </aside>


        <!-- MAIN CONTENT -->
        <main class="main-content">

            <!-- HEADER -->
