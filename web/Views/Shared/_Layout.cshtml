                    <i class="bi bi-list"></i>
                </button>

                <div class="topbar-title">
                    @ViewData["Title"]
                </div>

                <div class="topbar-right">

                    <button class="icon-button" type="button"
                            title="Thông báo">
                        <i class="bi bi-bell"></i>
                    </button>

                    <div class="user-info">
                        <div class="user-avatar">A</div>

                        <div class="user-details">
