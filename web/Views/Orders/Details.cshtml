@model web.Models.Entities.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";

    var isCancelled = Model.Status == "Cancelled";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Chi tiết đơn hàng
            </h2>

            <p class="text-muted mb-0">
                Mã đơn: @Model.OrderCode
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>
            Quay lại

        </a>

    </div>

    <!-- THONG BAO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- THONG TIN DON HANG -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">

            <h5 class="fw-bold mb-0">
                <i class="bi bi-receipt"></i>
                Thông tin đơn hàng
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-4">

                    <label class="text-muted small">
                        Mã đơn hàng
                    </label>

                    <div class="fw-bold">
                        @Model.OrderCode
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted small">
                        Ngày tạo
                    </label>

                    <div class="fw-bold">
                        @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted small">
                        Trạng thái
                    </label>

                    <div>

                        @if (isCancelled)
                        {
                            <span class="badge bg-secondary">
                                Đã hủy
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                Hoàn thành
                            </span>
                        }

                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted small">
                        Cửa hàng
                    </label>

                    <div class="fw-semibold">
                        @Model.Store?.StoreName
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted small">
                        Khách hàng
                    </label>

                    <div class="fw-semibold">
                        @(Model.Customer?.FullName ?? "Khách lẻ")
                    </div>

                </div>

                <div class="col-md-4">

                    <label class="text-muted small">
                        Người tạo
                    </label>

                    <div class="fw-semibold">
                        @(Model.User?.FullName ?? "Không xác định")
                    </div>

                </div>

                <div class="col-12">

                    <label class="text-muted small">
                        Ghi chú
                    </label>

                    <div>
                        @(string.IsNullOrWhiteSpace(Model.Note)
                            ? "Không có ghi chú"
                            : Model.Note)
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- CHI TIET SAN PHAM -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">

            <h5 class="fw-bold mb-0">
                <i class="bi bi-box-seam"></i>
                Chi tiết sản phẩm
            </h5>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>STT</th>
                        <th>Sản phẩm</th>
                        <th>Mã sản phẩm</th>
                        <th>Đơn vị</th>
                        <th class="text-end">Số lượng</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Giảm giá</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>

                </thead>

                <tbody>

                    @{
                        int index = 1;
                    }

                    @foreach (var detail in Model.OrderDetails)
                    {
                        <tr>

                            <td>
                                @index
                            </td>

                            <td class="fw-semibold">
                                @detail.Product?.ProductName
                            </td>

                            <td>
                                @detail.Product?.ProductCode
                            </td>

                            <td>
                                @detail.Product?.Unit
                            </td>

                            <td class="text-end">
                                @detail.Quantity.ToString("N3")
                            </td>

                            <td class="text-end">
                                @detail.UnitPrice.ToString("N0") đ
                            </td>

                            <td class="text-end text-danger">
                                @detail.DiscountAmount.ToString("N0") đ
                            </td>

                            <td class="text-end fw-bold">
                                @detail.LineTotal.ToString("N0") đ
                            </td>

                        </tr>

                        index++;
                    }

                    @if (!Model.OrderDetails.Any())
                    {
                        <tr>
                            <td colspan="8"
                                class="text-center py-4 text-muted">
                                Đơn hàng chưa có sản phẩm.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- TONG TIEN -->
    <div class="row justify-content-end">

        <div class="col-md-5">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between mb-3">

                        <span>Tạm tính</span>

                        <strong>
                            @Model.SubTotal.ToString("N0") đ
                        </strong>

                    </div>

                    <div class="d-flex justify-content-between mb-3">

                        <span>Giảm giá</span>

                        <strong class="text-danger">
                            -@Model.DiscountAmount.ToString("N0") đ
                        </strong>

                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">

                        <h5 class="fw-bold">
                            Tổng thanh toán
                        </h5>

                        <h5 class="fw-bold text-primary">
                            @Model.TotalAmount.ToString("N0") đ
                        </h5>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ACTION -->
    <div class="d-flex justify-content-end gap-2 mt-4">

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Quay lại danh sách
        </a>

        @if (!isCancelled)
        {
            <form asp-action="Cancel"
                  method="post"
                  onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này và hoàn lại tồn kho?');">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.OrderId" />

                <button type="submit"
                        class="btn btn-danger">

                    <i class="bi bi-x-circle"></i>
                    Hủy đơn hàng và hoàn kho

                </button>

            </form>
        }

    </div>

</div>
