@model web.ViewModels.OrderIndexViewModel

@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Quản lý đơn hàng
            </h2>

            <p class="text-muted mb-0">
                Quản lý và theo dõi các đơn hàng của cửa hàng
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Tạo đơn hàng
        </a>

    </div>

    <!-- THONG BAO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- SEARCH -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3">

                    <div class="col-md-3">

                        <label class="form-label">
                            Tìm kiếm
                        </label>

                        <input type="text"
                               name="keyword"
                               value="@Model.Keyword"
                               class="form-control"
                               placeholder="Mã đơn hoặc tên khách hàng" />

                    </div>

                    <div class="col-md-2">

                        <label class="form-label">
                            Trạng thái
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                Tất cả
                            </option>

                            <option value="Completed"
                                    selected="@(Model.Status == "Completed")">
                                Hoàn thành
                            </option>

                            <option value="Cancelled"
                                    selected="@(Model.Status == "Cancelled")">
                                Đã hủy
                            </option>

                        </select>

                    </div>

                    <div class="col-md-2">

                        <label class="form-label">
                            Từ ngày
                        </label>

                        <input type="date"
                               name="fromDate"
                               value="@Model.FromDate?.ToString("yyyy-MM-dd")"
                               class="form-control" />

                    </div>

                    <div class="col-md-2">

                        <label class="form-label">
                            Đến ngày
                        </label>

                        <input type="date"
                               name="toDate"
                               value="@Model.ToDate?.ToString("yyyy-MM-dd")"
                               class="form-control" />

                    </div>

                    <div class="col-md-3 d-flex align-items-end gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            <i class="bi bi-search"></i>
                            Tìm kiếm
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Làm mới
                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- TABLE -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between">

                <h5 class="mb-0 fw-bold">
                    Danh sách đơn hàng
                </h5>

                <a asp-action="Export"
                   asp-route-keyword="@Model.Keyword"
                   asp-route-status="@Model.Status"
                   asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                   asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                   class="btn btn-outline-success btn-sm">

                    <i class="bi bi-file-earmark-excel"></i>
                    Xuất CSV

                </a>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Mã đơn hàng</th>
                        <th>Ngày tạo</th>
                        <th>Cửa hàng</th>
                        <th>Khách hàng</th>
                        <th class="text-end">Tạm tính</th>
                        <th class="text-end">Giảm giá</th>
                        <th class="text-end">Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Orders.Any())
                    {
                        <tr>
                            <td colspan="9"
                                class="text-center py-5 text-muted">

                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>

                                Không tìm thấy đơn hàng.

                            </td>
                        </tr>
                    }

                    @foreach (var order in Model.Orders)
                    {
                        <tr>

                            <td class="fw-semibold">
                                @order.OrderCode
                            </td>

                            <td>
                                @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @order.Store?.StoreName
                            </td>

                            <td>
                                @(order.Customer?.FullName ?? "Khách lẻ")
                            </td>

                            <td class="text-end">
                                @order.SubTotal.ToString("N0") đ
                            </td>

                            <td class="text-end text-danger">
                                @order.DiscountAmount.ToString("N0") đ
                            </td>

                            <td class="text-end fw-bold">
                                @order.TotalAmount.ToString("N0") đ
                            </td>

                            <td>

                                @if (order.Status == "Completed")
                                {
                                    <span class="badge bg-success">
                                        Hoàn thành
                                    </span>
                                }
                                else if (order.Status == "Cancelled")
                                {
                                    <span class="badge bg-secondary">
                                        Đã hủy
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @order.Status
                                    </span>
                                }

                            </td>

                            <td class="text-center">

                                <a asp-action="Details"
                                   asp-route-id="@order.OrderId"
                                   class="btn btn-sm btn-outline-primary">

                                    <i class="bi bi-eye"></i>
                                    Chi tiết

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- PAGINATION -->
        <div class="card-footer bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <span class="text-muted">
                    Tổng cộng @Model.TotalItems đơn hàng
                </span>

                <nav>

                    <ul class="pagination mb-0">

                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-keyword="@Model.Keyword"
                               asp-route-status="@Model.Status"
                               asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                               asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">

                                Trước

                            </a>

                        </li>

                        <li class="page-item active">

                            <span class="page-link">
                                @Model.Page / @Math.Max(1, Model.TotalPages)
                            </span>

                        </li>

                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-keyword="@Model.Keyword"
                               asp-route-status="@Model.Status"
                               asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                               asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">

                                Sau

                            </a>

                        </li>

                    </ul>

                </nav>

            </div>

        </div>

    </div>

</div>
