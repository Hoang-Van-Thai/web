@model web.ViewModels.ForecastIndexViewModel

@{
    ViewData["Title"] = "Dự báo nhu cầu";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3>Dự báo nhu cầu sản phẩm</h3>
            <p class="text-muted mb-0">
                Sử dụng mô hình Machine Learning để dự báo nhu cầu bán hàng.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-graph-up"></i> Tạo dự báo mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">Lịch sử dự báo</h5>
        </div>

        <div class="card-body table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Mã dự báo</th>
                        <th>Tên phiên</th>
                        <th>Model</th>
                        <th>Cửa hàng</th>
                        <th>Ngày bắt đầu</th>
                        <th>Ngày kết thúc</th>
                        <th>Số ngày</th>
                        <th>Sản phẩm</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.ForecastRuns.Any())
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-4">
                                Chưa có phiên dự báo nào.
                            </td>
                        </tr>
                    }

                    @foreach (var item in Model.ForecastRuns)
                    {
                        <tr>
                            <td>#@item.ForecastRunId</td>
                            <td>@item.ForecastName</td>
                            <td>@item.ModelVersionName</td>
                            <td>
                                @(string.IsNullOrWhiteSpace(item.StoreNames)
                                    ? "-"
                                    : item.StoreNames)
                            </td>
                            <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.EndDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.HorizonDays ngày</td>
                            <td>@item.ProductCount</td>
                            <td>
                                @if (item.Status == "Completed")
                                {
                                    <span class="badge bg-success">Hoàn thành</span>
                                }
                                else if (item.Status == "Failed")
                                {
                                    <span class="badge bg-danger">Thất bại</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @item.Status
                                    </span>
                                }
                            </td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@item.ForecastRunId"
                                   class="btn btn-sm btn-outline-primary">
                                    Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>