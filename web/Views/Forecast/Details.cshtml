@model web.Services.ForecastExecutionResult

@{
    ViewData["Title"] = "Chi tiết dự báo";
}

<div class="container-fluid py-4">

    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Kết quả dự báo
            </h2>

            <p class="text-muted mb-0">
                Phiên dự báo #@Model.ForecastRunId
            </p>
        </div>

        <a asp-controller="Forecast"
           asp-action="Index"
           class="btn btn-outline-secondary">

            Quay lại

        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Thông tin dự báo -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-3">

                    <small class="text-muted">
                        Sản phẩm
                    </small>

                    <div class="fw-semibold">
                        @Model.ProductName
                    </div>

                </div>

                <div class="col-md-3">

                    <small class="text-muted">
                        Cửa hàng
                    </small>

                    <div class="fw-semibold">
                        @Model.StoreName
                    </div>

                </div>

                <div class="col-md-3">

                    <small class="text-muted">
                        Model
                    </small>

                    <div class="fw-semibold">
                        @Model.ActiveModel
                    </div>

                </div>

                <div class="col-md-3">

                    <small class="text-muted">
                        Thời gian dự báo
                    </small>

                    <div class="fw-semibold">
                        @Model.ForecastDays ngày
                    </div>

                </div>

                <div class="col-md-3">

                    <small class="text-muted">
                        Lịch sử sử dụng
                    </small>

                    <div class="fw-semibold">
                        @Model.HistoryDays ngày
                    </div>

                </div>

                <div class="col-md-3">

                    <small class="text-muted">
                        Ngày cuối lịch sử
                    </small>

                    <div class="fw-semibold">
                        @Model.LastHistoryDate.ToString("dd/MM/yyyy")
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Thống kê -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Tổng dự báo
                    </small>

                    <h3 class="fw-bold text-primary">
                        @Model.Statistics.Total.ToString("N2")
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Trung bình/ngày
                    </small>

                    <h3 class="fw-bold">
                        @Model.Statistics.Mean.ToString("N2")
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Thấp nhất
                    </small>

                    <h3 class="fw-bold text-warning">
                        @Model.Statistics.Minimum.ToString("N2")
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <small class="text-muted">
                        Cao nhất
                    </small>

                    <h3 class="fw-bold text-success">
                        @Model.Statistics.Maximum.ToString("N2")
                    </h3>

                </div>

            </div>

        </div>

    </div>

    <!-- Bảng dự báo -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                Dự báo theo ngày
            </h5>

        </div>

        <div class="card-body">

            @if (Model.Forecast.Count == 0)
            {
                <div class="alert alert-warning">
                    Không có dữ liệu dự báo.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>STT</th>
                                <th>Ngày</th>
                                <th class="text-end">
                                    Số lượng dự báo
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            @{
                                var index = 1;
                            }

                            @foreach (var item in Model.Forecast)
                            {
                                <tr>

                                    <td>
                                        @index
                                    </td>

                                    <td>
                                        @DateTime.Parse(item.Date).ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="text-end fw-semibold">
                                        @item.Prediction.ToString("N2")
                                    </td>

                                </tr>

                                index++;
                            }

                        </tbody>

                        <tfoot class="table-light">

                            <tr>

                                <th colspan="2">
                                    Tổng dự báo
                                </th>

                                <th class="text-end">
                                    @Model.Statistics.Total.ToString("N2")
                                </th>

                            </tr>

                        </tfoot>

                    </table>

                </div>
            }

        </div>

    </div>

</div>