@model web.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-5">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h3 class="text-center mb-4">
                        Đặt lại mật khẩu
                    </h3>


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <form asp-action="ResetPassword"
                          method="post">

                        @Html.AntiForgeryToken()


                        <input asp-for="Token"
                               type="hidden" />


                        <div class="mb-3">

                            <label asp-for="NewPassword"
                                   class="form-label">
                                Mật khẩu mới
                            </label>

                            <input asp-for="NewPassword"
                                   class="form-control"
                                   placeholder="Ít nhất 6 ký tự" />

                            <span asp-validation-for="NewPassword"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="ConfirmPassword"
                                   class="form-label">
                                Xác nhận mật khẩu
                            </label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   placeholder="Nhập lại mật khẩu" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>


                        <button type="submit"
                                class="btn btn-primary w-100">
                            Đặt lại mật khẩu
                        </button>

                    </form>


                    <div class="text-center mt-3">

                        <a asp-action="Login">
                            Quay lại đăng nhập
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}