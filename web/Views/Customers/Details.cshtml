@model web.ViewModels.CustomerDetailsViewModel

@{
    ViewData["Title"] = "Chi tiết khách hàng";
}

<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Chi tiết khách hàng</h3>
            <div class="text-muted">@Model.CustomerCode</div>
        </div>

        <div>
            <a asp-action="Edit"
               asp-route-id="@Model.CustomerId"
               class="btn btn-primary">
                <i class="bi bi-pencil"></i> Chỉnh sửa
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Quay lại
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Số đơn hoàn thành</div>
                    <h3 class="fw-bold">@Model.OrderCount</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Tổng chi tiêu</div>
                    <h3 class="fw-bold text-success">
                        @Model.TotalSpent.ToString("N0") đ
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Ngày mua gần nhất</div>
                    <h3 class="fw-bold">
                        @(Model.LastOrderDate?.ToString("dd/MM/yyyy") ?? "Chưa có")
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Thông tin khách hàng</h5>
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <strong>Mã khách hàng:</strong>
                    @Model.CustomerCode
                </div>

                <div class="col-md-6">
                    <strong>Họ tên:</strong>
                    @Model.FullName
                </div>

                <div class="col-md-6">
                    <strong>Số điện thoại:</strong>
                    @(Model.Phone ?? "—")
                </div>

                <div class="col-md-6">
                    <strong>Email:</strong>
                    @(Model.Email ?? "—")
                </div>

                <div class="col-md-6">
                    <strong>Giới tính:</strong>
                    @(Model.Gender ?? "—")
                </div>

                <div class="col-md-6">
                    <strong>Ngày sinh:</strong>
                    @(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")
                </div>

                <div class="col-md-6">
                    <strong>Địa chỉ:</strong>
                    @(Model.Address ?? "—")
                </div>

                <div class="col-md-6">
                    <strong>Ngày tạo:</strong>
                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">10 đơn hàng gần nhất</h5>
        </div>

        <div class="card-body table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Tổng tiền</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.RecentOrders.Any())
                    {
                        foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td>@order.OrderCode</td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge bg-success">
                                        @order.Status
                                    </span>
                                </td>
                                <td class="text-end">
                                    @order.TotalAmount.ToString("N0") đ
                                </td>
                                <td>
                                    <a asp-controller="Orders"
                                       asp-action="Details"
                                       asp-route-id="@order.OrderId"
                                       class="btn btn-sm btn-outline-info">
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-3">
                                Khách hàng chưa có đơn hàng hoàn thành.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <form asp-action="Delete"
          asp-route-id="@Model.CustomerId"
          method="post"
          class="mt-3"
          onsubmit="return confirm('Bạn có chắc muốn xóa khách hàng này?');">

        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-outline-danger">
            <i class="bi bi-trash"></i> Xóa khách hàng
        </button>
    </form>

</div>