@model web.ViewModels.StoreFormViewModel

@{
    ViewData["Title"] = "Chỉnh sửa cửa hàng";
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-action="Details"
           asp-route-id="@Model.StoreId"
           class="text-decoration-none">
            <i class="bi bi-arrow-left"></i> Quay lại chi tiết
        </a>

        <h2 class="fw-bold mt-2">Chỉnh sửa cửa hàng</h2>
        <p class="text-muted">
            Cập nhật thông tin cửa hàng @Model.StoreCode
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Edit"
                  asp-route-id="@Model.StoreId"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="StoreId" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="StoreCode" class="form-label"></label>
                        <input asp-for="StoreCode"
                               class="form-control" />
                        <span asp-validation-for="StoreCode"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StoreName" class="form-label"></label>
                        <input asp-for="StoreName"
                               class="form-control" />
                        <span asp-validation-for="StoreName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone"
                               class="form-control" />
                        <span asp-validation-for="Phone"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address"
                               class="form-control" />
                        <span asp-validation-for="Address"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="IsActive"
                                   class="form-check-input" />
                            <label asp-for="IsActive"
                                   class="form-check-label"></label>
                        </div>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Details"
                       asp-route-id="@Model.StoreId"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i>
                        Lưu thay đổi
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
