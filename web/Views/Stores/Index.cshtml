@model web.ViewModels.StoreIndexViewModel

@{
    ViewData["Title"] = "Quản lý cửa hàng";
}

<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Quản lý cửa hàng</h2>
            <p class="text-muted mb-0">
                Quản lý thông tin và trạng thái các cửa hàng
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Thêm cửa hàng
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Tổng cửa hàng</div>
                    <h3 class="fw-bold mb-0">
                        @Model.TotalStores
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Đang hoạt động</div>
                    <h3 class="fw-bold text-success mb-0">
                        @Model.ActiveStores
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Ngừng hoạt động</div>
                    <h3 class="fw-bold text-danger mb-0">
                        @Model.InactiveStores
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get">
                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Tìm kiếm cửa hàng</label>
                        <input type="text"
                               name="keyword"
                               value="@Model.Keyword"
                               class="form-control"
                               placeholder="Mã, tên, số điện thoại hoặc địa chỉ..." />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Trạng thái</label>
                        <select name="status" class="form-select">
                            <option value="">Tất cả</option>
                            <option value="active"
                                    selected="@(Model.Status == "active")">
                                Đang hoạt động
                            </option>
                            <option value="inactive"
                                    selected="@(Model.Status == "inactive")">
                                Ngừng hoạt động
                            </option>
                        </select>
                    </div>

                    <div class="col-md-3 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i> Tìm kiếm
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Xóa lọc
                        </a>
                    </div>

                </div>
            </form>

        </div>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Danh sách cửa hàng</h5>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>STT</th>
                        <th>Mã cửa hàng</th>
                        <th>Tên cửa hàng</th>
                        <th>Địa chỉ</th>
                        <th>Điện thoại</th>
                        <th class="text-center">Số kho</th>
                        <th class="text-center">Số đơn hàng</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Items.Any())
                    {
                        var index = 1;

                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@index</td>

                                <td>
                                    <strong>@item.StoreCode</strong>
                                </td>

                                <td>@item.StoreName</td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Address)
                                        ? "Chưa cập nhật"
                                        : item.Address)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Phone)
                                        ? "Chưa cập nhật"
                                        : item.Phone)
                                </td>

                                <td class="text-center">
                                    @item.WarehouseCount
                                </td>

                                <td class="text-center">
                                    @item.OrderCount
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Ngừng hoạt động
                                        </span>
                                    }
                                </td>

                                <td>
                                    @item.CreatedAt.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Details"
                                           asp-route-id="@item.StoreId"
                                           class="btn btn-sm btn-outline-info"
                                           title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.StoreId"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>

                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10"
                                class="text-center text-muted py-4">
                                Không tìm thấy cửa hàng nào.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>
