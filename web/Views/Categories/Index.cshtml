@model IEnumerable<web.Models.Entities.Category>

@{
    ViewData["Title"] = "Quản lý danh mục";

    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">Quản lý danh mục</h3>
            <p class="text-muted mb-0">
                Quản lý danh mục sản phẩm RetailFlow
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Export"
               asp-route-keyword="@ViewBag.Keyword"
               class="btn btn-outline-success">

                <i class="bi bi-file-earmark-spreadsheet"></i>
                Xuất Excel

            </a>

            <a asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-lg"></i>
                Thêm danh mục

            </a>

        </div>

    </div>

    <!-- THONG BAO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- THONG KE -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="text-muted small">
                        Tổng danh mục
                    </div>

                    <h3 class="fw-bold mb-0">
                        @ViewBag.TotalItems
                    </h3>

                </div>

            </div>

        </div>

    </div>

    <!-- TIM KIEM -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3">

                    <div class="col-md-5">

                        <label class="form-label">
                            Tìm kiếm
                        </label>

                        <input name="keyword"
                               value="@ViewBag.Keyword"
                               class="form-control"
                               placeholder="Nhập mã hoặc tên danh mục..." />

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            Sắp xếp
                        </label>

                        <select name="sort"
                                class="form-select">

                            <option value=""
                                    selected="@(ViewBag.Sort == null)">
                                Mặc định
                            </option>

                            <option value="code"
                                    selected="@(ViewBag.Sort as string == "code")">
                                Mã danh mục
                            </option>

                            <option value="name"
                                    selected="@(ViewBag.Sort as string == "name")">
                                Tên A-Z
                            </option>

                            <option value="name_desc"
                                    selected="@(ViewBag.Sort as string == "name_desc")">
                                Tên Z-A
                            </option>

                        </select>

                    </div>

                    <div class="col-md-3 d-flex align-items-end gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-fill">

                            <i class="bi bi-search"></i>
                            Tìm kiếm

                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-counterclockwise"></i>

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- DANH SACH -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-bold">
                Danh sách danh mục
            </h5>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>STT</th>

                            <th>Mã danh mục</th>

                            <th>Tên danh mục</th>

                            <th>Thao tác</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            int stt = (page - 1) *
                                (int)ViewBag.PageSize + 1;

                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>@stt</td>

                                    <td class="fw-semibold">
                                        @item.CategoryCode
                                    </td>

                                    <td>
                                        @item.CategoryName
                                    </td>

                                    <td>

                                        <div class="d-flex gap-1">

                                            <a asp-action="Details"
                                               asp-route-id="@item.CategoryId"
                                               class="btn btn-sm btn-outline-info"
                                               title="Chi tiết">

                                                <i class="bi bi-eye"></i>

                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.CategoryId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Chỉnh sửa">

                                                <i class="bi bi-pencil"></i>

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.CategoryId"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Xóa">

                                                <i class="bi bi-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="4"
                                    class="text-center py-5 text-muted">

                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>

                                    Không tìm thấy danh mục.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- PHAN TRANG -->
            @if (totalPages > 1)
            {
                <nav>

                    <ul class="pagination justify-content-end mb-0">

                        <li class="page-item @(page <= 1 ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(page - 1)"
                               asp-route-keyword="@ViewBag.Keyword"
                               asp-route-sort="@ViewBag.Sort">

                                Trước

                            </a>

                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == page ? "active" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-keyword="@ViewBag.Keyword"
                                   asp-route-sort="@ViewBag.Sort">

                                    @i

                                </a>

                            </li>
                        }

                        <li class="page-item @(page >= totalPages ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(page + 1)"
                               asp-route-keyword="@ViewBag.Keyword"
                               asp-route-sort="@ViewBag.Sort">

                                Sau

                            </a>

                        </li>

                    </ul>

                </nav>
            }

        </div>

    </div>

</div>