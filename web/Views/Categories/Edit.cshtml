@model web.ViewModels.CategoryViewModel

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="container py-4">

    <div class="mb-4">

        <h3 class="fw-bold">
            Chỉnh sửa danh mục
        </h3>

        <p class="text-muted">
            Cập nhật thông tin danh mục @Model.CategoryCode
        </p>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form asp-action="Edit"
                  asp-route-id="@Model.CategoryId"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="CategoryId" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="CategoryCode"
                               class="form-label">
                        </label>

                        <input asp-for="CategoryCode"
                               class="form-control" />

                        <span asp-validation-for="CategoryCode"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="CategoryName"
                               class="form-label">
                        </label>

                        <input asp-for="CategoryName"
                               class="form-control" />

                        <span asp-validation-for="CategoryName"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Hủy

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-save"></i>
                        Cập nhật

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}