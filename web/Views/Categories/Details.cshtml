@model web.Models.Entities.Category

@{
    ViewData["Title"] = "Chi tiết danh mục";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="fw-bold">
                Chi tiết danh mục
            </h3>

            <p class="text-muted mb-0">
                Thông tin danh mục sản phẩm
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            Quay lại

        </a>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">
                @Model.CategoryName
            </h5>

            <div class="row g-4">

                <div class="col-md-6">

                    <small class="text-muted">
                        ID danh mục
                    </small>

                    <div class="fw-semibold">
                        @Model.CategoryId
                    </div>

                </div>

                <div class="col-md-6">

                    <small class="text-muted">
                        Mã danh mục
                    </small>

                    <div class="fw-semibold">
                        @Model.CategoryCode
                    </div>

                </div>

                <div class="col-md-6">

                    <small class="text-muted">
                        Tên danh mục
                    </small>

                    <div class="fw-semibold">
                        @Model.CategoryName
                    </div>

                </div>

                <div class="col-md-6">

                    <small class="text-muted">
                        Tình trạng liên kết sản phẩm
                    </small>

                    <div>

                        @if ((bool)ViewBag.HasProducts)
                        {
                            <span class="badge bg-info">
                                Có sản phẩm liên kết
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Chưa có sản phẩm
                            </span>
                        }

                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.CategoryId"
                   class="btn btn-primary">

                    <i class="bi bi-pencil"></i>
                    Chỉnh sửa

                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.CategoryId"
                   class="btn btn-outline-danger">

                    <i class="bi bi-trash"></i>
                    Xóa danh mục

                </a>

            </div>

        </div>

    </div>

</div>