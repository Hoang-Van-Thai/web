@model web.ViewModels.ModelVersionCreateViewModel

@{
    ViewData["Title"] = "Đăng ký Model";
}

<div class="container py-3">
    <div class="mb-4">
        <h3>Đăng ký Model đã huấn luyện</h3>
        <p class="text-muted">
            Nhập thông tin model đã được huấn luyện bằng Python.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <h5>Thông tin Model</h5>
                <hr />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="VersionName" class="form-label"></label>
                        <input asp-for="VersionName" class="form-control"
                               placeholder="Ví dụ: LGBM_Global_V1" />
                        <span asp-validation-for="VersionName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ModelName" class="form-label"></label>
                        <input asp-for="ModelName" class="form-control" />
                        <span asp-validation-for="ModelName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-8 mb-3">
                        <label asp-for="ModelFilePath" class="form-label"></label>
                        <input asp-for="ModelFilePath" class="form-control"
                               placeholder="Tên file hoặc đường dẫn model phía Python" />
                        <span asp-validation-for="ModelFilePath"
                              class="text-danger"></span>
                        <small class="text-muted">
                            Đây là thông tin tham chiếu, ASP.NET không đọc file này.
                        </small>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Framework" class="form-label"></label>
                        <input asp-for="Framework" class="form-control" />
                        <span asp-validation-for="Framework"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control"
                                  rows="2"></textarea>
                    </div>
                </div>

                <h5 class="mt-3">Thông tin huấn luyện offline</h5>
                <hr />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="TrainingName" class="form-label"></label>
                        <input asp-for="TrainingName" class="form-control"
                               placeholder="M5 Global LightGBM Training" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DataStartDate" class="form-label"></label>
                        <input asp-for="DataStartDate" type="date"
                               class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DataEndDate" class="form-label"></label>
                        <input asp-for="DataEndDate" type="date"
                               class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Mae" class="form-label"></label>
                        <input asp-for="Mae" type="number" step="0.000001"
                               class="form-control" />
                        <span asp-validation-for="Mae" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Rmse" class="form-label"></label>
                        <input asp-for="Rmse" type="number" step="0.000001"
                               class="form-control" />
                        <span asp-validation-for="Rmse" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Rmsse" class="form-label"></label>
                        <input asp-for="Rmsse" type="number" step="0.000001"
                               class="form-control" />
                        <span asp-validation-for="Rmsse" class="text-danger"></span>
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="LogMessage" class="form-label"></label>
                        <textarea asp-for="LogMessage" class="form-control"
                                  rows="3"></textarea>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Lưu Model
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}