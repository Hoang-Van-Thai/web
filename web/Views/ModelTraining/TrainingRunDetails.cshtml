@model web.ViewModels.ModelTrainingRunItemViewModel

@{
    ViewData["Title"] = "Chi tiết huấn luyện";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Chi tiết phiên huấn luyện
            </h2>

            <p class="text-muted mb-0">
                Mã phiên: #@Model.TrainingRunId
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Quay lại
        </a>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <h5 class="fw-bold mb-3">
                Thông tin chung
            </h5>

            <div class="row g-3">

                <div class="col-md-6">
                    <div class="text-muted">Tên phiên</div>
                    <div class="fw-semibold">
                        @Model.TrainingName
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted">Phiên bản model</div>
                    <div class="fw-semibold">
                        @(Model.VersionName ?? "Chưa xác định")
                    </div>
                </div>

                <div class="col-md-6">

                    <div class="text-muted">Trạng thái</div>

                    @if (Model.Status == "Completed")
                    {
                        <span class="badge bg-success">
                            Hoàn thành
                        </span>
                    }
                    else if (Model.Status == "Training")
                    {
                        <span class="badge bg-warning text-dark">
                            Đang huấn luyện
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            @Model.Status
                        </span>
                    }

                </div>

                <div class="col-md-6">
                    <div class="text-muted">Bắt đầu</div>
                    <div>
                        @(Model.StartedAt?.ToString("dd/MM/yyyy HH:mm:ss") ?? "—")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted">Hoàn thành</div>
                    <div>
                        @(Model.CompletedAt?.ToString("dd/MM/yyyy HH:mm:ss") ?? "—")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted">Ngày dữ liệu bắt đầu</div>
                    <div>
                        @(Model.DataStartDate?.ToString("dd/MM/yyyy") ?? "—")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="text-muted">Ngày dữ liệu kết thúc</div>
                    <div>
                        @(Model.DataEndDate?.ToString("dd/MM/yyyy") ?? "—")
                    </div>
                </div>

            </div>

            <hr />

            <h5 class="fw-bold mb-3">
                Chỉ số đánh giá
            </h5>

            <div class="row g-3">

                <div class="col-md-4">
                    <div class="border rounded p-3">
                        <div class="text-muted">MAE</div>
                        <h4 class="fw-bold mb-0">
                            @(Model.Mae?.ToString("N4") ?? "—")
                        </h4>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded p-3">
                        <div class="text-muted">RMSE</div>
                        <h4 class="fw-bold mb-0">
                            @(Model.Rmse?.ToString("N4") ?? "—")
                        </h4>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded p-3">
                        <div class="text-muted">RMSSE</div>
                        <h4 class="fw-bold mb-0">
                            @(Model.Rmsse?.ToString("N4") ?? "—")
                        </h4>
                    </div>
                </div>

            </div>

            <hr />

            <h5 class="fw-bold mb-3">
                Nhật ký huấn luyện
            </h5>

            <div class="bg-light border rounded p-3"
                 style="white-space: pre-wrap; overflow-wrap: anywhere;">
                @(Model.LogMessage ?? "Không có thông tin.")
            </div>

        </div>

    </div>

</div>