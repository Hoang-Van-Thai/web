<!-- ============================================================
     CLIENT-SIDE PAGINATION
     MẶC ĐỊNH 10 DÒNG / TRANG
     KHÔNG CÓ Ô "HIỂN THỊ 10"
     ============================================================ -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const table = document.querySelector(".table");

        if (!table) {
            return;
        }

        const tbody = table.querySelector("tbody");

        if (!tbody) {
            return;
        }


        const rows = Array.from(
            tbody.querySelectorAll("tr")
        );


        // Không có dữ liệu
        if (rows.length === 0) {

            document.getElementById(
                "inventoryPaginationContainer"
            ).style.display = "none";

            return;
        }


        // Trường hợp "Không tìm thấy dữ liệu"
        if (
            rows.length === 1 &&
            rows[0].querySelector("td[colspan]")
        ) {

            document.getElementById(
                "inventoryPaginationContainer"
            ).style.display = "none";

            return;
        }


        // ==========================================
        // LUÔN LUÔN 10 DÒNG / TRANG
        // ==========================================

        const pageSize = 10;

        let currentPage = 1;

        const totalPages = Math.ceil(
            rows.length / pageSize
        );


        const pagination =
            document.getElementById(
                "inventoryPagination"
            );


        const pageInfo =
            document.getElementById(
                "inventoryPageInfo"
            );


        // ==========================================
        // HIỂN THỊ TRANG
        // ==========================================

        function renderPage(page) {

            currentPage = page;


            const start =
                (page - 1) * pageSize;


            const end =
                start + pageSize;


            rows.forEach(function (row, index) {

                if (
                    index >= start &&
                    index < end
                ) {

                    row.style.display = "";

                }
                else {

                    row.style.display = "none";

                }

            });


            // ======================================
            // CẬP NHẬT STT
            // ======================================

            rows.forEach(function (row, index) {

                if (
                    index >= start &&
                    index < end
                ) {

                    const numberCell =
                        row.querySelector(
                            ".row-number"
                        );


                    if (numberCell) {

                        numberCell.textContent =
                            index + 1;

                    }

                }

            });


            // ======================================
            // THÔNG TIN TRANG
            // ======================================

            pageInfo.textContent =
                "Trang " +
                currentPage +
                " / " +
                totalPages;


            renderPagination();

        }


        // ==========================================
        // TẠO NÚT PHÂN TRANG
        // ==========================================

        function renderPagination() {

            pagination.innerHTML = "";


            // ======================================
            // NÚT TRƯỚC
            // ======================================

            const previousButton =
                document.createElement("button");


            previousButton.type = "button";

            previousButton.className =
                "btn btn-outline-primary";


            previousButton.innerHTML =
                '<i class="bi bi-chevron-left"></i> Trước';


            previousButton.disabled =
                currentPage === 1;


            previousButton.addEventListener(
                "click",
                function () {

                    if (currentPage > 1) {

                        renderPage(
                            currentPage - 1
                        );

                    }

                }
            );


            pagination.appendChild(
                previousButton
            );


            // ======================================
            // SỐ TRANG
            // ======================================

            for (
                let i = 1;
                i <= totalPages;
                i++
            ) {

                const pageButton =
                    document.createElement("button");


                pageButton.type = "button";


                pageButton.className =
                    i === currentPage
                        ? "btn btn-primary"
                        : "btn btn-outline-primary";


                pageButton.textContent = i;


                pageButton.addEventListener(
                    "click",
                    function () {

                        renderPage(i);

                    }
                );


                pagination.appendChild(
                    pageButton
                );

            }


            // ======================================
            // NÚT SAU
            // ======================================

            const nextButton =
                document.createElement("button");


            nextButton.type = "button";

            nextButton.className =
                "btn btn-outline-primary";


            nextButton.innerHTML =
                'Sau <i class="bi bi-chevron-right"></i>';


            nextButton.disabled =
                currentPage === totalPages;


            nextButton.addEventListener(
                "click",
                function () {

                    if (
                        currentPage < totalPages
                    ) {

                        renderPage(
                            currentPage + 1
                        );

                    }

                }
            );


            pagination.appendChild(
                nextButton
            );

        }


        // ==========================================
        // CHẠY TRANG ĐẦU TIÊN
        // ==========================================

        renderPage(1);

    });

</script>
