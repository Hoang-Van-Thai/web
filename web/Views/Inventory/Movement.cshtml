@model web.ViewModels.InventoryMovementViewModel

@{
    ViewData["Title"] = Model.TransactionType == "IN"
        ? "Nhập kho"
        : "Xuất kho";

    bool isImport = Model.TransactionType == "IN";
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none">
            <i class="bi bi-arrow-left"></i> Quay lại tồn kho
        </a>

        <h2 class="fw-bold mt-2">
            @(isImport ? "Nhập kho" : "Xuất kho")
        </h2>

        <p class="text-muted">
            @(isImport
                ? "Ghi nhận số lượng hàng hóa nhập vào kho."
                : "Ghi nhận số lượng hàng hóa xuất khỏi kho.")
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Movement" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <input type="hidden"
                       asp-for="TransactionType" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">
                            Loại giao dịch
                        </label>

                        <select class="form-select"
                                id="transactionType"
                                name="TransactionType">
                            <option value="IN"
                                    selected="@(Model.TransactionType == "IN")">
                                Nhập kho
                            </option>
                            <option value="OUT"
                                    selected="@(Model.TransactionType == "OUT")">
                                Xuất kho
                            </option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="WarehouseId"
                               class="form-label">
                            Kho hàng
                        </label>

                        <select asp-for="WarehouseId"
                                asp-items="Model.Warehouses"
                                class="form-select">
                            <option value="0">-- Chọn kho --</option>
                        </select>

                        <span asp-validation-for="WarehouseId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ProductId"
                               class="form-label">
                            Sản phẩm
                        </label>

                        <select asp-for="ProductId"
                                asp-items="Model.Products"
                                class="form-select">
                            <option value="0">-- Chọn sản phẩm --</option>
                        </select>

                        <span asp-validation-for="ProductId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Quantity"
                               class="form-label">
                            Số lượng
                        </label>

                        <input asp-for="Quantity"
                               type="number"
                               step="0.001"
                               min="0.001"
                               class="form-control"
                               placeholder="Nhập số lượng..." />

                        <span asp-validation-for="Quantity"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ReferenceCode"
                               class="form-label">
                            Mã tham chiếu
                        </label>

                        <input asp-for="ReferenceCode"
                               class="form-control"
                               placeholder="Để trống để tự sinh mã" />

                        <small class="text-muted">
                            Ví dụ: NK202611110001 hoặc XK202611110001.
                        </small>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Note"
                               class="form-label">
                            Ghi chú
                        </label>

                        <input asp-for="Note"
                               class="form-control"
                               placeholder="Lý do nhập hoặc xuất kho..." />
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>

                    <button type="submit"
                            class="btn @(isImport ? "btn-success" : "btn-danger")">
                        @(isImport ? "Xác nhận nhập kho" : "Xác nhận xuất kho")
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById("transactionType")
            ?.addEventListener("change", function () {
                const url = new URL(window.location.href);
                url.searchParams.set("type", this.value);
                window.location.href = url.toString();
            });
    </script>
}
